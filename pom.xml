<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.ashenwarden</groupId>
  <artifactId>ashen-warden</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>
  <name>ASHEN WARDEN: THE LAST EMBER</name>
  <description>Interactive terminal gothic dark-fantasy turn-based RPG (CLI, Java 21, JLine 3 keyboard UI, MySQL + JDBC)</description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <jackson.version>2.18.2</jackson.version>
    <junit.version>5.11.4</junit.version>
    <mysql.version>8.4.0</mysql.version>
    <jline.version>3.30.17</jline.version>
  </properties>

  <dependencies>
    <!-- JLine 3 uber jar: raw-mode key input (arrow keys / Enter / Escape) and
         terminal capability detection for the interactive menu layer. -->
    <dependency>
      <groupId>org.jline</groupId>
      <artifactId>jline</artifactId>
      <version>${jline.version}</version>
    </dependency>

    <!-- JDBC driver for the local MySQL 8+ service -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <version>${mysql.version}</version>
      <scope>runtime</scope>
    </dependency>

    <!-- Documented parser dependency for UTF-8 content files (no hand-rolled JSON parser) -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>ashen-warden</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>com.ashenwarden.Main</mainClass>
            </manifest>
            <manifestEntries>
              <!-- JLine opens the console with the JDK foreign-function API;
                   this manifest flag (JEP 472) keeps Java 24+ quiet about it.
                   Older JDKs simply ignore the entry. -->
              <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
      <!-- Executable fat jar: java -jar target/ashen-warden.jar -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>                <transformers>
                  <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                    <mainClass>com.ashenwarden.Main</mainClass>
                    <manifestEntries>
                      <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                    </manifestEntries>
                  </transformer>
                </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <mainClass>com.ashenwarden.Main</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
